{
  "name": "teaching-calendar-widget",
  "version": "0.1.0",
  "private": true,
  "description": "教学日历桌面挂件 — 上传教学日历文件，生成桌面展示小组件",
  "author": "",
  "type": "commonjs",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/copy-preload.js",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/copy-preload.js",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-store": "^8.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.example.teaching-calendar-widget",
    "productName": "教学日历挂件",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "sign": false
    },
    "portable": {
      "artifactName": "教学日历挂件-portable.exe"
    },
    "electronVersion": "34.5.8",
    "electronDist": "D:\\Claude Code实战\\data\\teaching-calendar-widget\\node_modules\\electron\\dist",
    "forceCodeSigning": false
  }
}
